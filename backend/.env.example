# Biarkan DATABASE_URL kosong untuk SQLite lokal. Isi dengan URL PostgreSQL
# (misalnya dari Neon) saat menjalankan backend di lingkungan produksi.
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

APP_SECRET_KEY=
APP_COOKIE_SECURE=false

DEMO_TEACHER_NAME=
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=

DEMO_STUDENT_NAME=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_CLASS_NAME=Kelas Demo EssAI
